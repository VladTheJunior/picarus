{
    "branches": [
        "master"
    ],
    "plugins": [
        "@semantic-release/commit-analyzer",
        [
            "@semantic-release/release-notes-generator",
            {
                "linkCompare": false,
                "linkReferences": false,
                "writerOpts": {
                    "commitPartial": "* {{#if scope}}**{{scope}}:** {{/if}}{{subject}}\n"
                }
            }
        ],
        [
            "@semantic-release/changelog",
            {
                "changelogFile": "CHANGELOG.md"
            }
        ],
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "toml set Cargo.toml package.version \"${nextRelease.version}-${process.env.BRANCH_NAME}.${process.env.BUILD_NUMBER}\" > temp.toml && mv temp.toml Cargo.toml && cargo build --release"
            }
        ],
        [
            "@semantic-release/github",
            {
                "assets": [
                    {
                        "path": "target/release/picarus.exe"
                    }
                ]
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": [
                    "CHANGELOG.md"
                ],
                "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
            }
        ]
    ]
}